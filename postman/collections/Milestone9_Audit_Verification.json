{
  "info": {
    "name": "Golden Ribbon — Milestone 9 Audit Verification",
    "_postman_id": "m9-audit-verification",
    "description": "Verification requests for Milestone 9 audit logs, authorization, and tamper resistance.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "supabase_url", "value": "https://uvxpjrzqtmaterczzvjo.supabase.co" },
    { "key": "anon_key",     "value": "{{ANON_KEY}}" },
    { "key": "owner_token",  "value": "{{OWNER_TOKEN}}" },
    { "key": "manager_token","value": "{{MANAGER_TOKEN}}" },
    { "key": "cashier_token","value": "{{CASHIER_TOKEN}}" }
  ],
  "item": [
    {
      "name": "1. Owner — list_audit_logs (all time)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey",        "value": "{{anon_key}}" },
          { "key": "Authorization", "value": "Bearer {{owner_token}}" },
          { "key": "Content-Type",  "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"p_page\": 0, \"p_page_size\": 10, \"p_range_type\": \"all_time\" }"
        },
        "url": { "raw": "{{supabase_url}}/rest/v1/rpc/list_audit_logs", "host": ["{{supabase_url}}"], "path": ["rest", "v1", "rpc", "list_audit_logs"] }
      }
    },
    {
      "name": "2. Owner — list_audit_logs (today)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey",        "value": "{{anon_key}}" },
          { "key": "Authorization", "value": "Bearer {{owner_token}}" },
          { "key": "Content-Type",  "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"p_page\": 0, \"p_page_size\": 50, \"p_range_type\": \"today\" }"
        },
        "url": { "raw": "{{supabase_url}}/rest/v1/rpc/list_audit_logs", "host": ["{{supabase_url}}"], "path": ["rest", "v1", "rpc", "list_audit_logs"] }
      }
    },
    {
      "name": "3. Owner — filter by action (sale_completed)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey",        "value": "{{anon_key}}" },
          { "key": "Authorization", "value": "Bearer {{owner_token}}" },
          { "key": "Content-Type",  "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"p_page\": 0, \"p_page_size\": 20, \"p_range_type\": \"all_time\", \"p_action\": \"sale_completed\" }"
        },
        "url": { "raw": "{{supabase_url}}/rest/v1/rpc/list_audit_logs", "host": ["{{supabase_url}}"], "path": ["rest", "v1", "rpc", "list_audit_logs"] }
      }
    },
    {
      "name": "4. Owner — filter by entity_type (product)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey",        "value": "{{anon_key}}" },
          { "key": "Authorization", "value": "Bearer {{owner_token}}" },
          { "key": "Content-Type",  "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"p_page\": 0, \"p_page_size\": 20, \"p_range_type\": \"all_time\", \"p_entity_type\": \"product\" }"
        },
        "url": { "raw": "{{supabase_url}}/rest/v1/rpc/list_audit_logs", "host": ["{{supabase_url}}"], "path": ["rest", "v1", "rpc", "list_audit_logs"] }
      }
    },
    {
      "name": "5. Owner — get_audit_log_detail (replace with real ID)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey",        "value": "{{anon_key}}" },
          { "key": "Authorization", "value": "Bearer {{owner_token}}" },
          { "key": "Content-Type",  "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"p_log_id\": \"00000000-0000-0000-0000-000000000000\" }"
        },
        "url": { "raw": "{{supabase_url}}/rest/v1/rpc/get_audit_log_detail", "host": ["{{supabase_url}}"], "path": ["rest", "v1", "rpc", "get_audit_log_detail"] }
      }
    },
    {
      "name": "6. Manager — list_audit_logs (expect 401/403)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey",        "value": "{{anon_key}}" },
          { "key": "Authorization", "value": "Bearer {{manager_token}}" },
          { "key": "Content-Type",  "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"p_page\": 0, \"p_page_size\": 10, \"p_range_type\": \"all_time\" }"
        },
        "url": { "raw": "{{supabase_url}}/rest/v1/rpc/list_audit_logs", "host": ["{{supabase_url}}"], "path": ["rest", "v1", "rpc", "list_audit_logs"] }
      }
    },
    {
      "name": "7. Cashier — list_audit_logs (expect 401/403)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey",        "value": "{{anon_key}}" },
          { "key": "Authorization", "value": "Bearer {{cashier_token}}" },
          { "key": "Content-Type",  "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"p_page\": 0, \"p_page_size\": 10, \"p_range_type\": \"all_time\" }"
        },
        "url": { "raw": "{{supabase_url}}/rest/v1/rpc/list_audit_logs", "host": ["{{supabase_url}}"], "path": ["rest", "v1", "rpc", "list_audit_logs"] }
      }
    },
    {
      "name": "8. TAMPER — Direct INSERT into audit_logs (expect RLS rejection)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "apikey",        "value": "{{anon_key}}" },
          { "key": "Authorization", "value": "Bearer {{manager_token}}" },
          { "key": "Content-Type",  "value": "application/json" },
          { "key": "Prefer",        "value": "return=representation" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"actor_name_snapshot\": \"Hacker\", \"actor_role_snapshot\": \"owner\", \"action\": \"sale_completed\", \"entity_type\": \"sale\" }"
        },
        "url": { "raw": "{{supabase_url}}/rest/v1/audit_logs", "host": ["{{supabase_url}}"], "path": ["rest", "v1", "audit_logs"] }
      }
    },
    {
      "name": "9. TAMPER — Direct UPDATE on audit_logs (expect rejection)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "apikey",        "value": "{{anon_key}}" },
          { "key": "Authorization", "value": "Bearer {{owner_token}}" },
          { "key": "Content-Type",  "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"actor_name_snapshot\": \"Tampered\" }"
        },
        "url": { "raw": "{{supabase_url}}/rest/v1/audit_logs?limit=1", "host": ["{{supabase_url}}"], "path": ["rest", "v1", "audit_logs"], "query": [{ "key": "limit", "value": "1" }] }
      }
    },
    {
      "name": "10. TAMPER — Direct DELETE on audit_logs (expect rejection)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "apikey",        "value": "{{anon_key}}" },
          { "key": "Authorization", "value": "Bearer {{owner_token}}" }
        ],
        "url": { "raw": "{{supabase_url}}/rest/v1/audit_logs?limit=1", "host": ["{{supabase_url}}"], "path": ["rest", "v1", "audit_logs"], "query": [{ "key": "limit", "value": "1" }] }
      }
    }
  ]
}
